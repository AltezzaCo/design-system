{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F6F8F7" },
      "foreground": { "$value": "#10201D" },
      "border": { "$value": "#D6E0DD" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#10201D" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#10201D" },
      "primary": {
        "$value": "#0F766E",
        "$description": "Altezza teal. Drives primary actions, links, and active controls."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#E7F0EE" },
      "secondaryForeground": { "$value": "#173B35" },
      "muted": { "$value": "#EDF2F1" },
      "mutedForeground": { "$value": "#60706C" },
      "accent": {
        "$value": "#DDF7C8",
        "$description": "Soft opportunity lime for positive signals and selective emphasis."
      },
      "accentForeground": { "$value": "#17301B" },
      "destructive": { "$value": "#D14343" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#C8D6D2" },
      "ring": { "$value": "#0D9488" },
      "chart1": { "$value": "#0F766E" },
      "chart2": { "$value": "#65A30D" },
      "chart3": { "$value": "#2563EB" },
      "chart4": { "$value": "#7C3AED" },
      "chart5": { "$value": "#D97706" },
      "sidebar": { "$value": "#0B3F3A" },
      "sidebarForeground": { "$value": "#F3F7F5" },
      "sidebarBorder": { "$value": "#15534C" },
      "sidebarPrimary": { "$value": "#B8F28D" },
      "sidebarPrimaryForeground": { "$value": "#071311" },
      "sidebarAccent": { "$value": "#14574F" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#5EEAD4" }
    },
    "dark": {
      "background": { "$value": "#060F0D" },
      "foreground": { "$value": "#F3F7F5" },
      "border": { "$value": "#17312C" },
      "card": { "$value": "#0D1E1B" },
      "cardForeground": { "$value": "#F3F7F5" },
      "popover": { "$value": "#10241F" },
      "popoverForeground": { "$value": "#F3F7F5" },
      "primary": {
        "$value": "#2DD4BF",
        "$description": "Bright teal for decisive actions on dark operational surfaces."
      },
      "primaryForeground": { "$value": "#04100E" },
      "secondary": { "$value": "#15302B" },
      "secondaryForeground": { "$value": "#D6E7E2" },
      "muted": { "$value": "#10211E" },
      "mutedForeground": { "$value": "#8FA49E" },
      "accent": {
        "$value": "#B8F28D",
        "$description": "Opportunity lime reserved for success, readiness, and conversion signals."
      },
      "accentForeground": { "$value": "#071311" },
      "destructive": { "$value": "#DC5A5A" },
      "destructiveForeground": { "$value": "#FFF5F5" },
      "input": { "$value": "#24433D" },
      "ring": { "$value": "#5EEAD4" },
      "chart1": { "$value": "#2DD4BF" },
      "chart2": { "$value": "#B8F28D" },
      "chart3": { "$value": "#60A5FA" },
      "chart4": { "$value": "#A78BFA" },
      "chart5": { "$value": "#F59E0B" },
      "sidebar": { "$value": "#071512" },
      "sidebarForeground": { "$value": "#DDEBE7" },
      "sidebarBorder": { "$value": "#14302A" },
      "sidebarPrimary": { "$value": "#B8F28D" },
      "sidebarPrimaryForeground": { "$value": "#071311" },
      "sidebarAccent": { "$value": "#123029" },
      "sidebarAccentForeground": { "$value": "#F3F7F5" },
      "sidebarRing": { "$value": "#2DD4BF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "A calm 10px base radius for operational surfaces and controls."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
